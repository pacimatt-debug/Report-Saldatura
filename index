<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<style>
    /* STILE ORIGINALE INVARIATO */
    body { font-family: 'Roboto', sans-serif; background-color: #121212; padding: 20px; color: #e0e0e0; }
    .report-container { background: #1e1e1e; padding: 40px; border-radius: 8px; border: 1px solid #333; max-width: 950px; margin: auto; box-shadow: 0 4px 20px rgba(0,0,0,0.5); }
    .header-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; color: #fff; }
    .header-table td { border: 1px solid #444; padding: 10px; text-transform: uppercase; font-weight: bold; font-size: 0.8rem; }
    h1 { text-align: center; text-transform: uppercase; font-size: 1.6rem; margin-top: 0; border-bottom: 2px solid #4caf50; padding-bottom: 10px; color: #fff; }
    h2 { font-size: 1rem; text-transform: uppercase; background: #2d2d2d; padding: 8px; border-left: 4px solid #4caf50; margin-top: 25px; color: #fff; }
    .grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px; margin-bottom: 20px; }
    .grid-4 { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 10px; margin-bottom: 20px; }
    label { display: block; font-size: 0.7rem; color: #aaa; text-transform: uppercase; margin-bottom: 3px; }
    input, select, textarea { width: 100%; padding: 8px; border: 1px solid #444; background: #2d2d2d; color: #fff; font-size: 0.9rem; border-radius: 4px; box-sizing: border-box; }
    input:focus { border-color: #4caf50; outline: none; }
    .params-section { display: none; background: #252525; padding: 15px; border-radius: 4px; margin-top: 10px; border: 1px dashed #444; }
    .photo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 20px 0; }
    .photo-box { border: 2px dashed #444; height: 280px; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; overflow: hidden; background: #2d2d2d; }
    .photo-box img { max-width: 100%; max-height: 100%; object-fit: contain; }
    .photo-label { font-size: 0.75rem; font-weight: bold; margin-bottom: 10px; color: #4caf50; }
    .checklist { list-style: none; padding: 0; font-size: 0.85rem; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .checklist li { display: flex; align-items: center; background: #2d2d2d; padding: 8px; border-radius: 4px; }
    .checklist input { width: auto; margin-right: 10px; }
    .no-print { background: #4caf50; color: white; padding: 18px; border: none; width: 100%; cursor: pointer; font-weight: bold; margin-top: 30px; text-transform: uppercase; border-radius: 4px; font-size: 1rem; }
</style>
</head>
<body>

<div class="report-container">
    <table class="header-table">
        <tr>
            <td rowspan="2" style="width: 25%; text-align: center; vertical-align: middle; color: #4caf50; font-size: 1rem;">REPARTO<br>SALDATURA</td>
            <td>STUDENTE: <input type="text" id="std_nome" placeholder="COGNOME NOME"></td>
            <td>CLASSE: <input type="text" id="std_classe" placeholder="ES. 4AS" style="width: 80px;"></td>
        </tr>
        <tr>
            <td>ESERCITAZIONE N°: <input type="text" id="std_titolo" placeholder="TITOLO PROVA"></td>
            <td>DATA: <input type="date" id="std_data"></td>
        </tr>
    </table>

    <h1>Rapporto Tecnico di Saldatura</h1>
    
    <h2>1. Configurazione Macchina e Processo</h2>
    <div class="grid">
        <div>
            <label>Procedimento</label>
            <select id="processSelector" onchange="updateParams()">
                <option value="">-- Seleziona Processo --</option>
                <option value="mma">MMA (Elettrodo - Skyline CMD)</option>
                <option value="mig">MIG/MAG (Skyline CMD 2000)</option>
                <option value="tig">TIG DC (Skyline HFP 3000)</option>
            </select>
        </div>
        <div>
            <label>Posizione (ISO 6947)</label>
            <select id="std_pos">
                <option>PA (In piano)</option>
                <option>PB (Angolo in piano)</option>
                <option>PC (Trasversale)</option>
                <option>PF (Verticale ascendente)</option>
                <option>PG (Verticale discendente)</option>
            </select>
        </div>
        <div>
            <label>Materiale Base</label>
            <input type="text" id="std_mat" placeholder="Es. S235JR spessore 5mm">
        </div>
    </div>

    <div id="section-mma" class="params-section">
        <h2>Parametri MMA (Elettrodo)</h2>
        <div class="grid">
            <div><label>Tipo Elettrodo (AWS)</label><input type="text" id="mma_tipo" placeholder="Es. E6013"></div>
            <div><label>Ø Elettrodo (mm)</label><input type="number" id="mma_diam" inputmode="decimal" placeholder="2.5"></div>
            <div><label>Polo all'elettrodo</label><select id="mma_polo"><option>Negativo (-)</option><option>Positivo (+)</option></select></div>
        </div>
        <div class="grid">
            <div><label>Corrente (A)</label><input type="number" id="mma_amp" inputmode="numeric" placeholder="Ampere"></div>
        </div>
    </div>

    <div id="section-mig" class="params-section">
        <h2>Parametri MIG/MAG</h2>
        <div class="grid">
            <div><label>Ø Filo (mm)</label><input type="number" id="mig_diam" inputmode="decimal" placeholder="0.8"></div>
            <div><label>Velocità Filo (m/min)</label><input type="number" id="mig_vel" inputmode="decimal"></div>
            <div><label>Tensione (V)</label><input type="number" id="mig_volt" inputmode="decimal"></div>
        </div>
        <div class="grid">
            <div><label>Gas / Portata (lt/min)</label><input type="number" id="mig_gas" placeholder="Miscela 12 l/min"></div>
            <div><label>Induttanza</label><input type="number" id="mig_ind" inputmode="decimal"></div>
            <div><label>Modalità</label><select id="mig_mod"><option>2 Tempi</option><option>4 Tempi</option></select></div>
        </div>
    </div>

    <div id="section-tig" class="params-section">
        <h2>Parametri TIG DC (Skyline HFP 3000)</h2>
        <div class="grid-4">
            <div><label>Pre-Gas (s)</label><input type="number" id="tig_pre" inputmode="decimal"></div>          
            <div><label>Corrente (A)</label><input type="number" id="tig_base" inputmode="numeric"></div>
<div><label>Rampa Discesa (s)</label><input type="number" id="tig_down" inputmode="decimal"></div>
            <div><label>Post-Gas (s)</label><input type="number" id="tig_post" inputmode="decimal"></div>
            
        </div>
        <div class="grid">
            <div><label>N° Ceramica</label><input type="number" id="tig_cer" placeholder="Es. #6"></div>
            <div><label>Argon (lt/min)</label><input type="number" id="tig_gas_flow" inputmode="decimal"></div>
            <div><label>Ø Tungsteno (mm)</label><input type="number" id="tig_tun" inputmode="decimal" placeholder="2.4"></div>
        </div>
    </div>

    <h2>Rilevazioni Fotografiche</h2>
    <div class="photo-grid">
        <div class="photo-box">
            <span class="photo-label">FOTO PEZZO FINITO</span>
            <input type="file" accept="image/*" onchange="previewImg(this, 'img1')">
            <img id="img1" src="" style="display:none;">
        </div>
        <div class="photo-box">
            <span class="photo-label">DETTAGLIO CORDONE</span>
            <input type="file" accept="image/*" onchange="previewImg(this, 'img2')">
            <img id="img2" src="" style="display:none;">
        </div>
    </div>

    <h2>Checklist Qualità</h2>
    <ul class="checklist">
        <li><input type="checkbox" class="chk_q"> Larghezza uniforme</li>
        <li><input type="checkbox" class="chk_q"> Altezza uniforme</li>
        <li><input type="checkbox" class="chk_q"> Assenza di fessure</li>
        <li><input type="checkbox" class="chk_q"> Pulizia finale eseguita</li>
    </ul>

    <h2>Osservazioni Tecniche</h2>
    <textarea id="std_note" rows="3" placeholder="Note sul bagno di fusione o anomalie riscontrate..."></textarea>

    <button class="no-print" onclick="generaPDF()">Genera Report PDF</button>
</div>

<script>
    function updateParams() {
        const val = document.getElementById('processSelector').value;
        ['mma', 'mig', 'tig'].forEach(s => document.getElementById('section-'+s).style.display = 'none');
        if(val) document.getElementById('section-' + val).style.display = 'block';
    }

    function previewImg(input, id) {
        const reader = new FileReader();
        reader.onload = function(e) {
            const img = document.getElementById(id);
            img.src = e.target.result;
            img.style.display = 'block';
            input.style.display = 'none';
            input.previousElementSibling.style.display = 'none';
        }
        if(input.files[0]) reader.readAsDataURL(input.files[0]);
    }

    function generaPDF() {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();
        
        // --- INTESTAZIONE FISSA (Niente sovrapposizioni) ---
        doc.setDrawColor(0);
        doc.rect(10, 10, 190, 30); 
        doc.line(65, 10, 65, 40); 
        
        doc.setFont("helvetica", "bold");
        doc.setFontSize(10);
        doc.text("REPARTO", 37, 20, {align: "center"});
        doc.text("SALDATURA", 37, 28, {align: "center"});

        doc.setFontSize(8);
        doc.text("STUDENTE:", 70, 18);
        doc.setFont("helvetica", "normal");
        doc.text(document.getElementById('std_nome').value.toUpperCase(), 100, 18);
        
        doc.setFont("helvetica", "bold");
        doc.text("CLASSE:", 70, 25);
        doc.setFont("helvetica", "normal");
        doc.text(document.getElementById('std_classe').value, 100, 25);
        
        doc.setFont("helvetica", "bold");
        doc.text("ATTIVITÀ:", 70, 32);
        doc.setFont("helvetica", "normal");
        doc.text(document.getElementById('std_titolo').value, 100, 32);

        doc.setFont("helvetica", "bold");
        doc.text("DATA:", 160, 18);
        doc.setFont("helvetica", "normal");
        doc.text(document.getElementById('std_data').value, 175, 18);

        doc.setFontSize(16);
        doc.setFont("helvetica", "bold");
        doc.text("REPORT TECNICO DI SALDATURA", 105, 55, { align: "center" });

        // --- 1. CONFIGURAZIONE ---
        doc.setFontSize(10);
        doc.text("1. DATI DI PROCESSO", 10, 70);
        doc.line(10, 72, 200, 72);
        
        doc.setFont("helvetica", "normal");
        const proc = document.getElementById('processSelector').options[document.getElementById('processSelector').selectedIndex].text;
        doc.text(`Procedimento: ${proc}`, 15, 80);
        doc.text(`Materiale Base: ${document.getElementById('std_mat').value}`, 15, 87);
        doc.text(`Posizione (ISO 6947): ${document.getElementById('std_pos').value}`, 15, 94);

        // --- 2. PARAMETRI ---
        let yPos = 105;
        doc.setFont("helvetica", "bold");
        doc.text("2. PARAMETRI OPERATIVI", 10, yPos);
        doc.line(10, yPos+2, 200, yPos+2);
        doc.setFont("helvetica", "normal");
        yPos += 10;

        const val = document.getElementById('processSelector').value;
        if(val === 'mma') {
            doc.text(`Elettrodo: ${document.getElementById('mma_tipo').value} - Ø ${document.getElementById('mma_diam').value} mm`, 15, yPos);
            doc.text(`Corrente: ${document.getElementById('mma_amp').value} A (Polo: ${document.getElementById('mma_polo').value})`, 15, yPos+7);
        } else if(val === 'mig') {
            doc.text(`Filo: Ø ${document.getElementById('mig_diam').value} mm - Vel: ${document.getElementById('mig_vel').value} m/min - Volt: ${document.getElementById('mig_volt').value} V`, 15, yPos);
            doc.text(`Gas: ${document.getElementById('mig_gas').value} - Induttanza: ${document.getElementById('mig_ind').value} - Mod: ${document.getElementById('mig_mod').value}`, 15, yPos+7);
        } else if(val === 'tig') {
            doc.text(`Corrente 1: ${document.getElementById('tig_c1').value} A | Corrente 2: ${document.getElementById('tig_c2').value} A | Freq: ${document.getElementById('tig_freq').value} Hz`, 15, yPos);
            doc.text(`Gas: Pre ${document.getElementById('tig_pre').value}s / Post ${document.getElementById('tig_post').value}s | Ceramica: ${document.getElementById('tig_cer').value}`, 15, yPos+7);
            doc.text(`Rampe: Salita ${document.getElementById('tig_up').value}s / Discesa ${document.getElementById('tig_down').value}s`, 15, yPos+14);
            yPos += 7;
        }

        // --- 3. FOTO ---
        yPos += 15;
        doc.setFont("helvetica", "bold");
        doc.text("3. DOCUMENTAZIONE FOTOGRAFICA", 10, yPos);
        doc.line(10, yPos+2, 200, yPos+2);
        
        const img1 = document.getElementById('img1');
        const img2 = document.getElementById('img2');
        if(img1.src.length > 100) doc.addImage(img1.src, 'JPEG', 15, yPos+10, 85, 60);
        if(img2.src.length > 100) doc.addImage(img2.src, 'JPEG', 110, yPos+10, 85, 60);

        // --- 4. NOTE ---
        yPos += 85;
        doc.setFont("helvetica", "bold");
        doc.text("4. NOTE TECNICHE", 10, yPos);
        doc.line(10, yPos+2, 200, yPos+2);
        doc.setFont("helvetica", "normal");
        const noteText = document.getElementById('std_note').value || "Nessun commento tecnico inserito.";
        const splitNote = doc.splitTextToSize(noteText, 180);
        doc.text(splitNote, 10, yPos+10);

        doc.save("Report_Saldatura_" + document.getElementById('std_nome').value.replace(/\s+/g, '_') + ".pdf");
    }
</script>
</body>
</html>
